{
    "llm_name": "translategemma:12b",
    "memory_llm_name": "qwen3.5:4b",
    "font_path": "./fonts/animeace2_bld.otf",
    "image_enabled": false,
    "json_enabled": false,
    "memory_enabled": false,
    "expand_text_area": true,
    "max_font_size": 64,
    "ocr": {
        "pipeline": "detect_recognize",
        "detector": {
            "name": "yolo",
            "repo": "lordtrilink/manga-text-detector-v0",
            "conf": 0.05,
            "iou": 0.7,
            "imgsz": 1024
        },
        "recognizer": {
            "name": "paddleocr_vl",
            "model": "PaddlePaddle/PaddleOCR-VL-1.5",
            "max_tokens": 128,
            "crop_padding": 10
        },
        "grouping": {"method": "overlap", "threshold": 0.5}
    }
}
